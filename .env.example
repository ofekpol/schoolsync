# Supabase (D-02 — fill before running migrations or seed)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Direct Postgres connection for Drizzle migrations + seed (uses service role)
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# Test database (separate Supabase project recommended; falls back to skipping integration tests if unset)
TEST_DATABASE_URL=

# App URL for password reset redirect target
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ⚠️ TEST-ONLY BACKDOOR — DO NOT SET IN PRODUCTION ⚠️
# When set to "1", enables /api/v1/auth/login password-bypass for E2E tests.
# Any other value (or unset) returns 404 from that route.
# Setting this in prod = full auth bypass. Leave unset everywhere except local/CI.
TEST_LOGIN_ENABLED=

# Groq API key for the staff AI chatbot and smart event adder (console.groq.com → API Keys).
# When unset, the AI buttons are hidden and /api/v1/ai/* returns 503.
GROQ_API_KEY=

# Optional: override the Groq model id (default set in lib/ai/model.ts).
AI_MODEL=

# Staff "Help" form → issues in a PRIVATE repo (the app repo is public; reports carry names/emails).
# Token: fine-grained, only that repo, Issues: read & write. Both unset = Help link hidden.
GITHUB_SUPPORT_REPO=
GITHUB_SUPPORT_TOKEN=

# Public demo sandbox (/demo). Signs the demo session cookie and hashes client IPs.
# >= 32 random bytes, e.g. `openssl rand -base64 48`. Unset = /demo shows "unavailable".
DEMO_SESSION_SECRET=
# Vercel cron (vercel.json) sends `Authorization: Bearer $CRON_SECRET` to /api/cron/demo-cleanup.
CRON_SECRET=
# Optional: no new demos once the database is larger than this (default 350).
DEMO_DB_SIZE_LIMIT_MB=
# Optional: EduSolutions site for the demo's "back to site" / contact links.
NEXT_PUBLIC_EDUSOLUTIONS_SITE_URL=
